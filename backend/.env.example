# Copia este archivo como .env y llena los valores.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Opción 1: una sola URL (es lo que da Render)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/boncloud

# Opción 2: variables sueltas (se usan solo si no hay DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=boncloud
# DB_USER=postgres
# DB_PASSWORD=

# Orígenes permitidos por CORS, separados por comas
# CORS_ORIGINS=https://bonking14.github.io,http://localhost:5500

# PORT=4000

# ── Correo (recuperar contraseña y verificar correo) ──
# Clave de Resend (https://resend.com). Sin ella los enlaces se escriben en el registro del servidor.
# RESEND_API_KEY=re_xxxxxxxx
# Remitente. Sin dominio propio verificado en Resend solo sirve onboarding@resend.dev
# y los correos llegan únicamente a la dirección de tu cuenta de Resend.
# EMAIL_FROM=BonCloud <onboarding@resend.dev>
# Dirección pública de la web, para armar los enlaces de los correos
# APP_URL=https://bonking14.github.io/bon-cloud-5.0/

# Correos (separados por comas) que pasan a administrador cuando verifican su dirección
# ADMIN_EMAILS=tu-correo@example.com

# Con true, un profesor solo puede crear grupos si su institución tiene la licencia vigente
# LICENCIA_OBLIGATORIA=false
