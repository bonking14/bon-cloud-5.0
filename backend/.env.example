# Copia este archivo como .env y llena los valores.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Opción 1: una sola URL (es lo que da Render)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/boncloud

# Opción 2: variables sueltas (se usan solo si no hay DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=boncloud
# DB_USER=postgres
# DB_PASSWORD=

# Orígenes permitidos por CORS, separados por comas
# CORS_ORIGINS=https://bonking14.github.io,http://localhost:5500

# PORT=4000
